# Copy to .env.local: the values below boot the app in dev. Never commit .env.local.

# === App ===
VITE_APP_NAME="agentic-chat"
# Where the app is served, for the canonical and og:url links. Public: it's bundled into the client.
VITE_SITE_URL=http://localhost:3000
# dev, test or prod. Dev-only behaviour (emails printed to the console) refuses to run outside dev.
AC_ENV=dev

# === Database (ParadeDB from compose.yaml) ===
# The app connects as ac_app, which owns nothing, so row-level security binds it. `pnpm db:migrate` gives the role
# this password.
DATABASE_URL=postgres://ac_app:ac_app@localhost:5432/ac
# The owner, which bypasses row-level security: migrations and the work that crosses tenants on purpose (the outbox
# relay, ex smoke). Never give it to request code.
DATABASE_ADMIN_URL=postgres://ac:ac@localhost:5432/ac

# === Auth (better-auth) ===
BETTER_AUTH_URL=http://localhost:3000

# === Secrets ===
# Dev values, public on purpose: with AC_ENV=prod the app refuses to start on them.
# For a real deploy, generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-better-auth-secret-not-for-production
TOAST_SECRET=dev-toast-secret-not-for-production-use

# === Model providers (not needed in M0: tests use fakes) ===
OPENAI_API_KEY=
COHERE_API_KEY=

# === Agents ===
# 1 stops every tenant's agent runs before their next model turn or tool call. Per tenant: agent_switches.
# AGENT_KILL_SWITCH=0
# Which runner drives agent runs: workflow (Vercel Workflow, durable; the default), queue (the hand-built job queue,
# with checkpoints; dev only) or inline (in the request's server process, not durable).
# AGENT_RUNNER=workflow

# === fake-workspace ===
FAKE_WORKSPACE_URL=http://localhost:8100
# The corpus fake-workspace serves.
AC_CORPUS_DIR=fixtures/corpus/build
# Sent as the x-workspace-control header on /_control requests. A custom header makes a browser preflight, so a web
# page can't post to the control API. Dev value, public on purpose.
FAKE_WORKSPACE_CONTROL_TOKEN=dev-workspace-control
# The dev server queues a delta sync of every tenant this often (default 5 minutes), for directory changes and to
# renew the drive subscription.
# SYNC_INTERVAL_MS=300000

# === Course ===
# `pnpm ex start` sets the active step; these override it for one run. Leave them unset here.
# AC_ACTIVE_STEP=_smoke.1
# AC_SLOT_ROOT=playground
