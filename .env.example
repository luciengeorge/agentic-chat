# Copy to .env. Defaults target services on localhost: Postgres from brew
# (postgresql@18 + pgvector), the rest on their Compose ports. The app
# containers override the addresses with service names and host.docker.internal.
AC_ENV=dev

AC_DATABASE_URL=postgresql+psycopg://ac:ac@localhost:5432/ac
AC_DATABASE_URL_POOLED=postgresql+psycopg://ac:ac@localhost:5432/ac
AC_REDIS_URL=redis://localhost:6379/0
AC_TEMPORAL_ADDRESS=localhost:7233
AC_TEMPORAL_NAMESPACE=default
AC_OPENSEARCH_URL=http://localhost:9200
AC_S3_ENDPOINT=http://localhost:9000
AC_S3_ACCESS_KEY=minioadmin
AC_S3_SECRET_KEY=minioadmin
AC_RERANKER_URL=http://localhost:8200
# fake-workspace serves the corpus `ex fixtures` builds. Defaults to
# <repo>/fixtures/corpus/build; Compose points it at the /repo mount.
# AC_CORPUS_DIR=

# fake | cassette | openai
AC_MODEL_PROVIDER=fake
# Only needed when AC_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Overrides .ex/state.json. Normally left unset; `ex start` manages it.
# AC_ACTIVE_STEP=
AC_SLOT_ROOT=playground

# Web BFF (apps/web). The defaults work locally.
AC_KEYCLOAK_URL=http://localhost:8081
AC_GATEWAY_URL=http://localhost:8080
AC_WEB_ORIGIN=http://localhost:3000
AC_WEB_CLIENT_ID=web-bff
AC_WEB_CLIENT_SECRET=dev-web-bff-secret

# Workshop app. Defaults to two directories above apps/workshop.
# AC_REPO_ROOT=
