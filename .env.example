# Copy to .env.local: the values below boot the app in dev. Never commit .env.local.
#
# A deploy (section 22) sets its variables in Vercel's project settings instead, never from this file. In prod the
# server refuses to start until every variable marked [prod: required] is set, and names each one that's missing
# (src/lib/env-check.ts). It also refuses the public dev values of the three secrets.

# === App ===
VITE_APP_NAME="agentic-chat"
# Where the app is served, for the canonical and og:url links. Public: it's bundled into the client at build time,
# so on Vercel it's a build-time variable (the production domain).
VITE_SITE_URL=http://localhost:3000
# dev, test or prod. Dev-only behaviour (emails printed to the console, the labs that show other people's access)
# refuses to run outside dev. [prod: leave it unset] A production build with no AC_ENV runs as prod.
AC_ENV=dev

# === Database (ParadeDB from compose.yaml) ===
# [prod: required] The app connects as ac_app, which owns nothing, so row-level security binds it. `pnpm db:migrate`
# gives the role this password. In the cloud: postgres://ac_app:<openssl rand -hex 16>@<host>:5432/ac?sslmode=require
DATABASE_URL=postgres://ac_app:ac_app@localhost:5432/ac
# [prod: required] The owner, which bypasses row-level security: migrations and the work that crosses tenants on
# purpose (the outbox relay and the other cron routes, ex smoke). Never give it to request code. In the cloud it must
# be a superuser or have BYPASSRLS; `pnpm db:migrate:remote` checks.
DATABASE_ADMIN_URL=postgres://ac:ac@localhost:5432/ac

# === Auth (better-auth) ===
# [prod: required] The deployment's own origin: https://<project>.vercel.app in production. A preview has its own URL,
# so set this per branch in Vercel (Settings, Environment Variables, Preview, the branch).
BETTER_AUTH_URL=http://localhost:3000

# === Secrets ===
# Dev values, public on purpose: in prod the app refuses to start on them.
# [prod: required] For a real deploy, generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-better-auth-secret-not-for-production
TOAST_SECRET=dev-toast-secret-not-for-production-use
# [prod: required] Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>` to the routes in vercel.json, which
# refuse every other caller. In dev the server plugins do that work, so this only lets you call a route by hand:
#   curl -H "Authorization: Bearer dev-cron-secret-not-for-production" http://localhost:3000/api/cron/relay
CRON_SECRET=dev-cron-secret-not-for-production

# === Model providers ===
# [prod: required, unless MODEL_PROVIDER=local] Tests use fakes and never need them.
# OpenAI: platform.openai.com, API keys. Cohere: dashboard.cohere.com, API keys (a trial key is rate limited).
OPENAI_API_KEY=
COHERE_API_KEY=
# hosted (the default) or local: every model on this machine through LM Studio (section 21). A Vercel build has no
# local models; `pnpm build:local` is for a machine of your own.
# MODEL_PROVIDER=hosted

# === Agents ===
# 1 stops every tenant's agent runs before their next model turn or tool call. Per tenant: agent_switches.
# AGENT_KILL_SWITCH=0
# Which runner drives agent runs: workflow (Vercel Workflow, durable; the default), queue (the hand-built job queue,
# with checkpoints; on a deploy the agent-queue cron route works it, a minute at a time) or inline (in the request's
# server process, not durable).
# AGENT_RUNNER=workflow

# === Observability (section 19, optional) ===
# Off unless set. In the cloud, an OTLP endpoint such as Grafana Cloud's.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=agentic-chat
# Prompts and replies on spans hold tenant documents: only with this set to true.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# Conversations as JSON lines, through the outbox (19.4). A file sink suits one machine, not a serverless deploy.
# CONVERSATION_LOG_FILE=/tmp/kestrel-conversations.jsonl

# === The workspace connector (fake-workspace) ===
# [prod: optional] The drive and directory the syncs read. Outside prod it defaults to http://localhost:8100. A deploy
# has no fake-workspace, so leave it unset there: the sync cron route then queues nothing and says so.
FAKE_WORKSPACE_URL=http://localhost:8100
# [prod: required with FAKE_WORKSPACE_URL] Each tenant's token for its site, as WORKSPACE_TOKEN_<SLUG>. Outside prod,
# fake-workspace's public dev tokens are used.
# WORKSPACE_TOKEN_KESTREL=
# WORKSPACE_TOKEN_HARBOUR=
# The corpus fake-workspace serves.
AC_CORPUS_DIR=fixtures/corpus/build
# Sent as the x-workspace-control header on /_control requests. A custom header makes a browser preflight, so a web
# page can't post to the control API. Dev value, public on purpose.
FAKE_WORKSPACE_CONTROL_TOKEN=dev-workspace-control
# The dev server queues a delta sync of every tenant this often (default 5 minutes), for directory changes and to
# renew the drive subscription. On a deploy, vercel.json's schedule for /api/cron/sync does it instead.
# SYNC_INTERVAL_MS=300000
# How a sync starts its ingest runs: outbox (the default: the relay starts them from rows written with the new
# versions) or workflow-first (the sync workflow starts them, and each run writes its own record).
# INGEST_START=outbox
# OCR'd pages under this mean word confidence (0 to 100) are queued for review; 0 turns the queue off.
# OCR_REVIEW_THRESHOLD=70

# === Checking a deploy: `pnpm ex smoke --target <url>` (section 22.3) ===
# Leave them unset here; give them on the command line for one run.
# The deploy's CRON_SECRET. With it, the smoke also calls each cron route once (which changes the deploy's data).
# SMOKE_CRON_SECRET=
# Vercel's "Protection Bypass for Automation" secret, when Deployment Protection guards the preview.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# === Course ===
# `pnpm ex start` sets the active step; these override it for one run. Leave them unset here.
# AC_ACTIVE_STEP=_smoke.1
# AC_SLOT_ROOT=playground
