+/**
+ * agentic-chat patch: esbuild plugins the app registers on
+ * `globalThis[Symbol.for('workflow.esbuildPlugins')]` run first in the steps
+ * and workflow bundles, which are built outside the app's Vite pipeline. The
+ * app uses it to resolve `#learn/*` through the active step's slots.
+ */
+function appEsbuildPlugins() {
+    return globalThis[Symbol.for('workflow.esbuildPlugins')] ?? [];
+}
