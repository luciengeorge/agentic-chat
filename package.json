{
  "name": "agentic-chat",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#learn/*": "./src/core/*.ts"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "test": "vitest run",
    "lint": "oxfmt src scripts vite-plugins servers && oxlint src scripts vite-plugins servers",
    "lint:check": "oxfmt --check src scripts vite-plugins servers && oxlint src scripts vite-plugins servers",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "ex": "dotenv -e .env.local -- tsx scripts/ex.ts",
    "db:up": "docker compose up --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx src/db/migrate-main.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "sync": "dotenv -e .env.local -- tsx src/db/request-sync.ts",
    "db:embed": "dotenv -e .env.local -- tsx src/db/embed-main.ts",
    "eval": "dotenv -e .env.local -- tsx scripts/eval.ts",
    "agent:kill-proof": "dotenv -e .env.local -- tsx scripts/agent-kill-proof.ts",
    "redteam": "dotenv -e .env.local -- tsx scripts/redteam.ts",
    "agent:scenarios": "dotenv -e .env.local -- tsx scripts/agent-scenarios.ts",
    "auth:generate": "dotenv -e .env.local -- auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes",
    "fake-workspace": "dotenv -e .env.local -- tsx watch servers/fake-workspace/main.ts"
  },
  "dependencies": {
    "@ai-sdk/cohere": "4.0.60",
    "@ai-sdk/openai": "^4.0.93",
    "@ai-sdk/provider": "4.0.27",
    "@ai-sdk/provider-utils": "5.0.59",
    "@ai-sdk/react": "^4.0.142",
    "@ai-sdk/workflow": "2.0.71",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@napi-rs/canvas": "1.0.11",
    "@paradedb/drizzle-paradedb": "0.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/router-plugin": "^1.168.45",
    "@tesseract.js-data/eng": "1.0.0",
    "ai": "^7.0.139",
    "ajv": "8.20.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "gpt-tokenizer": "4.0.0",
    "iron-session": "^9.0.1",
    "mammoth": "1.13.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "openai": "^7.32.0",
    "postgres": "3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "uuid": "^14.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "workflow": "5.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@workflow/vitest": "5.0.4",
    "auth": "1.7.7",
    "diff": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "jsdom": "^30.1.2",
    "oxc-transform-react": "^0.154.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
